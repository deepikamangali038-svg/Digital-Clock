```verilog
`timescale 1ns/1ps

module digital_clock #(
    parameter CLK_FREQ = 10
)(
    input  wire       clk,
    input  wire       reset,
    output reg [4:0]  hours,
    output reg [5:0]  minutes,
    output reg [5:0]  seconds
);

    reg [31:0] clk_count;

    always @(posedge clk) begin
        if (reset) begin
            clk_count <= 0;
            hours     <= 0;
            minutes   <= 0;
            seconds   <= 0;
        end
        else begin
            if (clk_count == CLK_FREQ - 1) begin
                clk_count <= 0;

                if (seconds == 59) begin
                    seconds <= 0;

                    if (minutes == 59) begin
                        minutes <= 0;

                        if (hours == 23)
                            hours <= 0;
                        else
                            hours <= hours + 1;
                    end
                    else begin
                        minutes <= minutes + 1;
                    end
                end
                else begin
                    seconds <= seconds + 1;
                end
            end
            else begin
                clk_count <= clk_count + 1;
            end
        end
    end

endmodule
